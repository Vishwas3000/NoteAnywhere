<Window x:Class="NoteAnywhere.SearchPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search Notes" Width="600" Height="440" WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Deactivated="OnDeactivated" PreviewKeyDown="OnKey">
  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  </Window.Resources>
  <Border BorderThickness="1" BorderBrush="#33808080">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Margin="18,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="22" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBox x:Name="Query" Grid.Column="1" FontSize="22" BorderThickness="0" Background="Transparent" TextChanged="OnQuery"
                 AutomationProperties.Name="Search all notes" AutomationProperties.HelpText="Up and Down Arrow choose a note, Return opens it in NoteAnywhere, Escape closes"/>
        <TextBlock x:Name="QueryHint" Grid.Column="1" Text="Search notes" FontSize="22" Opacity="0.4" Margin="4,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
      <Border DockPanel.Dock="Top" Height="1" Background="#33808080"/>
      <Border DockPanel.Dock="Bottom" Height="1" Background="#33808080"/>
      <TextBlock DockPanel.Dock="Bottom" Margin="16,8" FontSize="12" Opacity="0.6" Text="↑↓  Select     ↩  Open     Esc  Close"/>
      <Grid>
        <ListBox x:Name="Results" BorderThickness="0" Background="Transparent" Margin="8" MouseDoubleClick="OnOpen"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="4,6">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Preview}" Opacity="0.75" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding Where}" FontSize="12" Opacity="0.55" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="Hint" VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="Search Your Notes" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="Find any note by meaning or keyword, from every app and website." Opacity="0.7" Margin="0,6,0,0"/>
        </StackPanel>
      </Grid>
    </DockPanel>
  </Border>
</Window>
