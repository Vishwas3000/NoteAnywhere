<Window x:Class="NoteAnywhere.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NoteAnywhere"
        xmlns:editor="clr-namespace:NoteAnywhere.Editor"
        Title="NoteAnywhere" Width="1100" Height="720" MinWidth="760" MinHeight="480">
  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <local:SidebarRowStyles x:Key="RowStyles"/>
    <DataTemplate DataType="{x:Type local:HeaderItem}">
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,14,0,2"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:FolderItem}">
      <Grid Margin="0,2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" Text="{Binding Count}" Opacity="0.6"/>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:TagItem}">
      <Grid Margin="0,2">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" Foreground="#C78A00"/>
        <TextBlock Grid.Column="1" Text="{Binding Count}" Opacity="0.6"/>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:NoteItem}">
      <Grid Margin="0,10" ToolTip="{Binding Source}" ToolTipService.IsEnabled="{Binding Note.HasSource}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Background="{Binding Strip}" CornerRadius="2" Margin="-6,2,0,2"/>
        <StackPanel Grid.Column="1">
          <DockPanel>
            <TextBlock Text="&#xE72E; " FontFamily="{StaticResource Icons}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Visibility="{Binding LockVisibility}"/>
            <TextBlock Text="&#xE735;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="#E6B800" Margin="6,0,0,0" VerticalAlignment="Center"
                       DockPanel.Dock="Right" Visibility="{Binding StarVisibility}"/>
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <TextBlock TextTrimming="CharacterEllipsis" Margin="0,4,0,0" FontSize="13">
            <Run Text="{Binding SourceGlyph, Mode=OneWay}" FontFamily="{StaticResource Icons}" FontSize="11"/><Run Text="{Binding Date, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Preview, Mode=OneWay}" Foreground="Gray"/>
          </TextBlock>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" MinWidth="230" MaxWidth="440"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0">
      <Grid DockPanel.Dock="Top" Margin="12,12,12,4">
        <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" AutomationProperties.Name="Search notes"/>
        <TextBlock x:Name="SearchHint" Text="Search notes" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.5" IsHitTestVisible="False"/>
      </Grid>
      <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="12,6,12,12" Click="OnNewFolder" Background="Transparent" BorderThickness="0">
        <TextBlock Opacity="0.75"><Run Text="&#xE710;" FontFamily="{StaticResource Icons}"/><Run Text="  New Folder"/></TextBlock>
      </Button>
      <ListBox x:Name="Sidebar" BorderThickness="0" Padding="8,0" Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyleSelector="{StaticResource RowStyles}"
               SelectionChanged="OnSidebarSelection" ContextMenuOpening="OnSidebarMenu" KeyDown="OnSidebarKey">
        <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
      </ListBox>
    </DockPanel>
    <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" Background="#22808080"/>
    <Grid Grid.Column="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,10,12,0">
        <Button Click="OnNewNote" ToolTip="New Note (Ctrl+N)" Padding="10,6">
          <TextBlock><Run Text="&#xE70F;" FontFamily="{StaticResource Icons}"/><Run Text="  New Note"/></TextBlock>
        </Button>
        <Button x:Name="DeleteButton" Click="OnDelete" ToolTip="Delete Note" Margin="8,0,0,0" Padding="10,6"
                Content="&#xE74D;" FontFamily="{StaticResource Icons}" AutomationProperties.Name="Delete Note"/>
      </StackPanel>
      <StackPanel Grid.Row="1" MaxWidth="680" Margin="56,8,56,0">
        <TextBlock x:Name="SourceLine" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="EditedLine" HorizontalAlignment="Center" FontSize="12" Opacity="0.6" Margin="0,8,0,0"/>
      </StackPanel>
      <editor:EditorView x:Name="Editor" Grid.Row="2" Margin="0,16,0,0"/>
      <StackPanel x:Name="NothingSelected" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
        <TextBlock Text="No Note Selected" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="Pick a note in the sidebar, or press Ctrl+N to start one." Opacity="0.7" Margin="0,6,0,0"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
