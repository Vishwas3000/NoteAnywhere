<Window x:Class="NoteAnywhere.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:NoteAnywhere.Editor"
        Title="NoteAnywhere" Width="1100" Height="720" MinWidth="760" MinHeight="480">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <ListBox x:Name="NoteList" Grid.Column="0" BorderThickness="0" SelectionChanged="OnSelect"/>
    <editor:EditorView x:Name="Editor" Grid.Column="1"/>
  </Grid>
</Window>
