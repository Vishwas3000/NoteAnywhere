<Window x:Class="NoteAnywhere.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to NoteAnywhere" Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="Step" TargetType="Border">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="CornerRadius" Value="13"/>
      <Setter Property="Background" Value="#F5B800"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>
    <Style x:Key="StepNumber" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="Black"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>
  <StackPanel Margin="28">
    <Image Source="/Assets/icon128.png" Width="72" Height="72" AutomationProperties.Name="NoteAnywhere"/>
    <TextBlock Text="Welcome to NoteAnywhere" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
    <TextBlock Text="Notes that show up where they belong." Opacity="0.7" HorizontalAlignment="Center" Margin="0,4,0,22"/>
    <TextBlock TextWrapping="Wrap" Margin="0,0,0,22"
               Text="Notes follow the window you're in: the file, the chat or the channel. Write one beside a file, and it's there the next time you open it."/>
    <DockPanel Margin="0,0,0,18">
      <Border Style="{StaticResource Step}"><TextBlock Text="1" Style="{StaticResource StepNumber}"/></Border>
      <StackPanel>
        <TextBlock Text="Open your notes from anywhere" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0"
                   Text="Alt+Shift+M shows the notes for the window in front. Alt+Shift+Space searches all of them."/>
      </StackPanel>
    </DockPanel>
    <DockPanel Margin="0,0,0,22">
      <Border Style="{StaticResource Step}"><TextBlock Text="2" Style="{StaticResource StepNumber}"/></Border>
      <StackPanel>
        <TextBlock Text="Add the browser extension" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,10"
                   Text="Your notes on the web pages they're about, in Chrome, Edge, Brave or Firefox. Edit a note in either place and the other updates."/>
        <Button Content="Get the Extension" HorizontalAlignment="Left" Padding="12,5" Click="OnGetExtension"/>
      </StackPanel>
    </DockPanel>
    <Button Content="Get Started" IsDefault="True" HorizontalAlignment="Right" Padding="16,5" Click="OnGetStarted"/>
  </StackPanel>
</Window>
