{
  "manifest_version": 3,
  "name": "MemoryNotes",
  "version": "0.1.0",
  "description": "Overlay your MemoryNotes on the sites and pages they belong to.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Toggle MemoryNotes"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "overlay.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
