// noteanywhere.app: the site and the DMG are static files (D71); worker/index.js only answers /api/feedback (D72).
// Deploy: copy the release DMG to site/NoteAnywhere.dmg (gitignored), then `npx wrangler@4 deploy`.
{
  "name": "noteanywhere",
  "compatibility_date": "2026-11-01",
  "main": "./worker/index.js",
  "assets": { "directory": "./site", "binding": "ASSETS" },
  "routes": [
    { "pattern": "noteanywhere.app", "custom_domain": true },
    { "pattern": "www.noteanywhere.app", "custom_domain": true }
  ],
  // Needs Email Routing on for the domain, with this address verified as a destination.
  "send_email": [{ "name": "FEEDBACK", "destination_address": "timeupvishwa@gmail.com" }],
  // Per visitor IP: 5 messages a minute.
  "ratelimits": [{ "name": "LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
