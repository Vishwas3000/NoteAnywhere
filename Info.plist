<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key><string>com.memorynotes.app</string>
	<key>CFBundleName</key><string>NoteAnywhere</string>
	<key>CFBundleDisplayName</key><string>NoteAnywhere</string>
	<key>CFBundleExecutable</key><string>MemoryNotes</string>
	<key>CFBundleIconFile</key><string>AppIcon</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>0.1</string>
	<key>CFBundleVersion</key><string>1</string>
	<key>LSMinimumSystemVersion</key><string>15.0</string>
	<key>NSHighResolutionCapable</key><true/>
	<!-- Sparkle updates (docs/DECISIONS.md D75). scripts/install.sh removes SUFeedURL, so dev builds don't update. -->
	<key>SUFeedURL</key><string>https://noteanywhere.app/appcast.xml</string>
	<!-- Sparkle's EdDSA public key; its private half is only in the maintainer's keychain. Installed copies accept only
	     updates signed for the key they shipped with, so changing it cuts them off from updates. -->
	<key>SUPublicEDKey</key><string>JU7KuMY4t2vaDMzAJWTpyMNDbUmhIHCt4JAZAr+Kh6k=</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key><string>com.memorynotes.auth</string>
			<key>CFBundleURLSchemes</key><array><string>memorynotes</string></array>
		</dict>
	</array>
</dict>
</plist>
